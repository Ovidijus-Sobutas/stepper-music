# Local settings for this project. Copy this file to ".env" (same folder) and change the values.
# ".env" is not committed to git, so your own password and paths stay on your PC.
# After changing it: run tools\prepare_firmware.ps1, then compile and flash the ESP8266 again.

# ---------------------------------------------------------------- built into the ESP8266 firmware

# Password of the setup hotspot "MusicPlayer-XXXX" (WPA2: 8-63 characters).
# It is shown on the OLED setup screen, so whoever has the player can always read it.
WIFI_AP_PASSWORD=change-me-please

# Network name of the player: the page opens at http://<PLAYER_NAME>.local
# Letters, digits and "-" only. Give each player its own name if there are several on one network.
PLAYER_NAME=musicplayer

# ---------------------------------------------------------------- only for the tools on your PC (tools\*.ps1)

# Address of the player used by the test scripts. Empty = <PLAYER_NAME>.local
# If .local names don't work on your PC, put the IP shown on the OLED here.
PLAYER_HOST=

# Folder with reference songs made by the original Python converter (midi_to_stepper.py), for
# the converter test (tools\serve.ps1 + converter_test.html). Empty = songs\demos in this repo.
REFERENCE_SONG_DIR=
